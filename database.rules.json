{
  "rules": {
    "siteConfig": {
      ".read": true,
      ".write": "auth != null && auth.token.email === 'ghaud21@gmail.com' && auth.token.email_verified === true"
    },
    "rooms": {
      "$roomCode": {
        ".read": "auth != null",
        "players": {
          "$uid": {
            ".write": "auth != null && auth.uid === $uid"
          }
        },
        "characterClaims": {
          "$characterId": {
            ".write": "auth != null && root.child('rooms').child($roomCode).child('players').child(auth.uid).exists() && (!data.exists() || data.val() === auth.uid)"
          }
        },
        "clues": {
          "$clueId": {
            ".write": "auth != null && root.child('rooms').child($roomCode).child('players').child(auth.uid).exists() && (!data.child('claimedBy').exists() || data.child('claimedBy').val() === auth.uid)"
          }
        },
        "resolution": {
          "accusations": {
            "$uid": { ".write": "auth != null && auth.uid === $uid" }
          },
          "moralChoices": {
            "$uid": { ".write": "auth != null && auth.uid === $uid" }
          },
          "selfReport": {
            "$uid": { ".write": "auth != null && auth.uid === $uid" }
          }
        },
        "ready": {
          "$targetPhase": {
            "$uid": { ".write": "auth != null && auth.uid === $uid" }
          }
        },
        "meta": {
          ".write": "auth != null && (!data.exists() || auth.uid === data.child('hostUid').val())"
        },
        ".write": "auth != null && (!data.exists() || auth.uid === data.child('meta').child('hostUid').val())"
      }
    },
    "mysteryRooms": {
      "$code": {
        ".read": "auth != null",
        ".write": "auth != null && (!data.exists() || data.child('players').child(auth.uid).exists() || (newData.child('players').child(auth.uid).exists() && data.child('meta/status').val() === 'waiting'))",
        "meta": {
          ".validate": "newData.hasChildren(['scenarioId', 'hostUid', 'playerCount'])"
        }
      }
    }
  }
}
