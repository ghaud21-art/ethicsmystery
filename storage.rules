rules_version = '2';

// 시나리오 미디어(놓친 장면 영상·음성·이미지) 전용 버킷 규칙.
// 읽기는 공개(학생 플레이), 쓰기는 관리자 계정만. 파일당 100MB 제한.
service firebase.storage {
  match /b/{bucket}/o {
    match /scenario-media/{scenarioId}/{fileName} {
      allow read: if true;
      allow write: if request.auth != null
        && request.auth.token.email == 'ghaud21@gmail.com'
        && request.auth.token.email_verified == true
        && (request.resource == null || request.resource.size < 100 * 1024 * 1024);
    }
  }
}
